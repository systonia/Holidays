{
    "name": "systonia/holidays",
    "description": "The public holidays of Germany, nationwide and per state.",
    "type": "library",
    "keywords": ["holidays", "feiertage", "germany", "calendar"],
    "license": "MIT OR Apache-2.0",
    "authors": [
        {
            "name": "Lento Leisenfeld",
            "homepage": "https://systonia.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Systonia\\Holidays\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Systonia\\Holidays\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
